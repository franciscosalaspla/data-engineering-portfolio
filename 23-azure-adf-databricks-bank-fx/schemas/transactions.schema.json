{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/p23/schemas/transactions.schema.json",
  "title": "Bank FX transaction row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction_id",
    "account_id",
    "transaction_timestamp",
    "amount",
    "currency",
    "transaction_type",
    "merchant_id",
    "merchant_name",
    "merchant_category",
    "channel",
    "status",
    "source_batch_id"
  ],
  "properties": {
    "transaction_id": {"type": "string", "pattern": "^TXN-[0-9]{4}$"},
    "account_id": {"type": "string", "pattern": "^ACC-[0-9]{3}$"},
    "transaction_timestamp": {"type": "string", "format": "date-time"},
    "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
    "currency": {"enum": ["EUR", "USD", "GBP"]},
    "transaction_type": {"enum": ["PURCHASE", "TRANSFER", "PAYMENT", "WITHDRAWAL"]},
    "merchant_id": {"type": "string", "pattern": "^MER-[0-9]{3}$"},
    "merchant_name": {"type": "string", "minLength": 1},
    "merchant_category": {
      "enum": [
        "GROCERIES",
        "TRANSFER",
        "TRANSPORT",
        "BUSINESS_SERVICES",
        "TRAVEL",
        "CASH_WITHDRAWAL",
        "ELECTRONICS"
      ]
    },
    "channel": {"enum": ["ATM", "CARD", "MOBILE", "ONLINE"]},
    "status": {"enum": ["APPROVED", "DECLINED", "PENDING"]},
    "source_batch_id": {"enum": ["BATCH-001", "BATCH-002"]}
  }
}
