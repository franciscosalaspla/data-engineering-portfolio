{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/p23/schemas/accounts.schema.json",
  "title": "Synthetic bank accounts fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_metadata", "accounts"],
  "properties": {
    "fixture_metadata": {"$ref": "#/$defs/fixtureMetadata"},
    "accounts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/account"}
    }
  },
  "$defs": {
    "fixtureMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_synthetic", "schema_version"],
      "properties": {
        "is_synthetic": {"const": true},
        "schema_version": {"const": "1.0.0"}
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "customer_id", "account_type", "base_currency", "opened_date", "status"],
      "properties": {
        "account_id": {"type": "string", "pattern": "^ACC-[0-9]{3}$"},
        "customer_id": {"type": "string", "pattern": "^CUS-[0-9]{3}$"},
        "account_type": {"enum": ["CHECKING", "SAVINGS", "CREDIT", "BUSINESS"]},
        "base_currency": {"enum": ["EUR", "USD", "GBP"]},
        "opened_date": {"type": "string", "format": "date"},
        "status": {"enum": ["ACTIVE", "SUSPENDED", "CLOSED"]}
      }
    }
  }
}
